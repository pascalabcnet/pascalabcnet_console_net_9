<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Для Visual Studio используем только одну цель -->
    <TargetFramework Condition="'$(BuildingInsideVisualStudio)' == 'true'">net9.0</TargetFramework>
    <!-- Для командной строки - обе цели -->
    <TargetFrameworks Condition="'$(BuildingInsideVisualStudio)' != 'true'">net48;net9.0</TargetFrameworks>

    <SolutionRoot>$(MSBuildThisFileDirectory)</SolutionRoot>

    <!-- Выходные пути для DLL/EXE -->
    <OutputPath Condition="'$(TargetFramework)' == 'net48'">$(SolutionRoot)bin\net48\</OutputPath>
    <OutputPath Condition="'$(TargetFramework)' == 'net9.0'">$(SolutionRoot)bin\net9\</OutputPath>

    <!-- Папка с общими ресурсами -->
    <SharedResourcesPath>..\bin\shared\</SharedResourcesPath>
    
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Глобальная папка obj для промежуточных файлов -->
    <BaseIntermediateOutputPath>$(SolutionRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(TargetFramework)\</IntermediateOutputPath>
    
    <!-- Символы условной компиляции -->
    <DefineConstants Condition="'$(TargetFramework)' == 'net48'">NETFRAMEWORK;NET48</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net9.0'">NET;NET9_0;NETCOREAPP</DefineConstants>
  </PropertyGroup>
</Project>